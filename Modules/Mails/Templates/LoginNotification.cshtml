@model Dictionary<string, string>
<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background-color: #2196F3; color: white; text-align: center; padding: 20px; }
        .info-box { background-color: #f9f9f9; padding: 15px; border-radius: 5px; margin: 20px 0; }
        .alert { padding: 15px; background-color: #f0f8ff; border-left: 4px solid #2196F3; margin: 20px 0; }
        .footer { text-align: center; padding: 20px; color: #666; font-size: 12px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header"><h1>🔐 Login Notification</h1></div>
        <div class="content">
            <h2>Hello @Model["UserName"],</h2>
            <div class="alert">
                <strong>We noticed a new login to your @Model["CompanyName"] account.</strong>
            </div>
            <div class="info-box">
                <p><strong>📅 Login Time:</strong> @Model["LoginTime"]</p>
                <p><strong>🌐 IP Address:</strong> @Model["IpAddress"]</p>
                <p><strong>🖥️ Device:</strong> @Model["UserAgent"]</p>
            </div>
            <p>If this was not you, please change your password immediately and contact support.</p>
            <p>Best regards,<br>The @Model["CompanyName"] Security Team</p>
        </div>
        <div class="footer">
            <p>&copy; 2025 @Model["CompanyName"]. All rights reserved.</p>
        </div>
    </div>
</body>
</html>